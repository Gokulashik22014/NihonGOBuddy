{
  "name": "nihongobuddy",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start":"electron .",
    "build-react":"cd frontend && npm run build",
    "pack":"electron-builder"
  },
  "build": {
    "appId": "com.example.offlineapp",
    "productName": "nihongobuddy",
    "files": [
      "frontend/dist/**/*",
      "backend/**/*",
      "main.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
